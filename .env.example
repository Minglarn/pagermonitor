MQTT_PASS=your_real_password_here
MQTT_TOPIC=pagermonitor/alarms

# HTTP-autentisering (lämna AUTH_PASS tomt för att inaktivera)
AUTH_USER=admin
AUTH_PASS=ditt_sakna_losenord

# UDP JSON Forwarder (skickar full POCSAG JSON till extern host via UDP)
UDP_FORWARD_ENABLED=false
UDP_FORWARD_HOST=192.168.1.100
UDP_FORWARD_PORT=5599
